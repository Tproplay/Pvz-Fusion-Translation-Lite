# Ignore everything by default
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/LICENSE
!/THIRD_PARTY.md
!/requirements.txt
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/assets/
!/assets/**
!/translation-data/
!/translation-data/**

# Ignore generated dumps or large work files if needed
translation-data/Dumps/untranslated_dump*.json

# Ignore game builds, large binary artifacts, signing keys, and intermediate files
*.apk
*.aab
*.dat
*.unity3d
*.assets
*.resource
*.resources
*.dll
*.exe
*.zip
*.rar
*.7z
*.jks
*.keystore
*.p12
*.pem
*.key

# Explicitly track public release signing materials
!docs/signing/
!docs/signing/**
.venv/
build/
temp/
artifacts/
decoded/
extracted/
generated/
tools/
vendor/
translator-source/
il2cpp/
analysis/
__pycache__/
*.pyc
